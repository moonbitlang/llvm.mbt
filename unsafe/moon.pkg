      "cc-link-flags": "-L/opt/homebrew/Cellar/llvm@18/18.1.8/lib -Wl,-search_paths_first -Wl,-headerpad_max_install_names -lLLVM-18 -lpthread -ldl -lm -lstdc++",
    },
  },
)
