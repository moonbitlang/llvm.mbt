// Type aliases
pub using @unsafe {type LLVMValueRef as ValueRef}

// Traits
pub trait AbstractType : Type {
  fn asAbstractTypeEnum(Self) -> AbstractTypeEnum
}

pub trait AggregateType : Type {
  fn asAggregateTypeEnum(Self) -> AggregateTypeEnum
  fn getElementType(Self, Int) -> &Type?
}

pub trait Constant : Value {
  fn asConstantEnum(Self) -> ConstantEnum
}

pub trait FPType : PrimitiveType {
  fn asFPTypeEnum(Self) -> FPTypeEnum
  fn getFPMantissaWidth(Self) -> UInt
}

pub trait GlobalValue : Value {
  fn asGlobalEnum(Self) -> GlobalEnum
  fn getLinkage(Self) -> Linkage
  fn setLinkage(Self, Linkage) -> Unit
  fn getUnnamedAddr(Self) -> UnnamedAddr
  fn setUnnamedAddr(Self, UnnamedAddr) -> Unit
  fn removeUnnamedAddr(Self) -> Unit
}

trait InsertPoint

pub trait Instruction : Value {
  fn asInstEnum(Self) -> InstructionEnum
  fn getParentBasicBlock(Self) -> BasicBlock?
  fn getNextInst(Self) -> &Instruction?
  fn getPrevInst(Self) -> &Instruction?
  fn removeFromParent(Self) -> Unit
  fn eraseFromParent(Self) -> Unit
  fn getNumArgOperands(Self) -> Int
}

pub trait IntegerType : PrimitiveType {
  fn asIntegerTypeEnum(Self) -> IntegerTypeEnum
  fn getExtendedType(Self) -> &IntegerType?
}

pub trait PrimitiveType : Type {
  fn asPrimitiveTypeEnum(Self) -> PrimitiveTypeEnum
  fn getBitWidth(Self) -> Int
}

pub trait Type : Show {
  fn getTypeRef(Self) -> @unsafe.LLVMTypeRef
  fn asTypeEnum(Self) -> TypeEnum
  fn getContext(Self) -> Context
  fn is16bitFPTy(Self) -> Bool
  fn isIEEELikeFPTy(Self) -> Bool
  fn isFloatingPointTy(Self) -> Bool
  fn isScalableTargetExtTy(Self) -> Bool
  fn isScalableTy(Self) -> Bool
  fn isFPOrFPVectorTy(Self) -> Bool
  fn isIntOrIntVectorTy(Self) -> Bool
  fn isIntOrPtrTy(Self) -> Bool
  fn isPtrOrPtrVectorTy(Self) -> Bool
  fn isEmptyTy(Self) -> Bool
  fn isFirstClassType(Self) -> Bool
  fn isSingleValueType(Self) -> Bool
  fn isAggregateType(Self) -> Bool
  fn isSized(Self) -> Bool
  fn sizeOf(Self) -> &Value?
  fn isValidGEPType(Self) -> Bool
  fn getScalarType(Self) -> &Type
  fn tryAsIntType(Self) -> &IntegerType?
  fn tryAsIntTypeEnum(Self) -> IntegerTypeEnum?
  fn tryAsFPType(Self) -> &FPType?
  fn tryAsFPTypeEnum(Self) -> FPTypeEnum?
  fn tryAsPrimitiveType(Self) -> &PrimitiveType?
  fn tryAsPrimitiveTypeEnum(Self) -> PrimitiveTypeEnum?
  fn tryAsAggregateType(Self) -> &AggregateType?
  fn tryAsAggregateTypeEnum(Self) -> AggregateTypeEnum?
  fn tryAsAbstractType(Self) -> &AbstractType?
  fn tryAsAbstractTypeEnum(Self) -> AbstractTypeEnum?
}

pub trait Value : Show {
  fn getValueRef(Self) -> @unsafe.LLVMValueRef
  fn asValueEnum(Self) -> ValueEnum
  fn getType(Self) -> &Type
  fn getContext(Self) -> Context
  fn getValueName(Self) -> String? raise
  fn setValueName(Self, String) -> Unit
  fn replaceAllUsesWith(Self, &Value) -> Unit
  fn tryAsConstant(Self) -> &Constant?
  fn tryAsConstantEnum(Self) -> ConstantEnum?
}
