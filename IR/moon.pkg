supported_targets = "native"

import {
  "Kaida-Amethyst/llvm/unsafe",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/uint",
}

options(
  "is-main": false,
  "native-stub": [ "resource_owner.c", "resource_owner_test.c" ],
  link: {
    "native": {
      "stub-cc": "cc",
      "stub-cc-flags": "${build.LLVM_MBT_STUB_CC_FLAGS}",
    },
  },
)
